"""
Full-throttle climb from a level release, flown to a held attitude.

The same pilot as the take-off but with no ground underneath, which is how the
two attitude loops are checked on their own: the aircraft must settle into a
steady climb at a constant speed with the wings level, rather than phugoiding
or rolling off under the propeller torque.
"""
test component TestMotorGliderClimb
  world = MultibodyComponents.World() {^world}
  atm = Atmosphere(rho0 = 1.225) {^atm}
  glider = MotorGlider(V_start = 30.0, gamma_start = 0.0, theta_start = 0.0) {^glider}
  "Already above the rotation speed, so the climb attitude is commanded throughout"
  pilot = Pilot(theta_climb = 0.12, V_rotate = 22.0) {^pilot}
  rud = BlockComponents.Sources.Constant(k = 0.0) {^rud}
  thr = BlockComponents.Sources.Constant(k = 1.0) {^thr}
relations
  connect(atm.air, glider.air, pilot.air) {^id7}
  connect(glider.frame_datum, pilot.frame_a) {^id8}
  connect(pilot.elevator, glider.elevator) {^id9}
  connect(pilot.aileron, glider.aileron) {^id10}
  connect(rud.y, glider.rudder) {^id11}
  connect(thr.y, glider.throttle) {^id12}
metadata {
  "_links": {
    "world": {
      "Dyad": {"placement": {"diagram": {"x1": 60, "y1": 800, "x2": 160, "y2": 900}}}
    },
    "atm": {
