"""
Sitting on the ground, engine off, released a little above its wheels.

A taildragger: the main wheels hang further below the datum than the tailwheel
does, so it settles nose-up on all three. With the main wheels on a track it
stands up by itself and the wing tip skids stay unloaded --- they are there for
a dropped wing, not to hold it up.
"""
test component TestMotorGliderParked
  world = MultibodyComponents.World() {^world}
  atm = Atmosphere(rho0 = 1.225) {^atm}
  glider = MotorGlider(has_gear = true, V_start = 0.0, gamma_start = 0.0, theta_start = 0.12, r_start = [0.0, 0.95, 0.0]) {^glider}
  elev = BlockComponents.Sources.Constant(k = 0.0) {^elev}
  rud = BlockComponents.Sources.Constant(k = 0.0) {^rud}
  ail = BlockComponents.Sources.Constant(k = 0.0) {^ail}
  thr = BlockComponents.Sources.Constant(k = 0.0) {^thr}
relations
  connect(atm.air, glider.air) {^id8}
  connect(elev.y, glider.elevator) {^id9}
  connect(rud.y, glider.rudder) {^id10}
  connect(ail.y, glider.aileron) {^id11}
  connect(thr.y, glider.throttle) {^id12}
metadata {
  "_links": {
    "world": {
      "Dyad": {"placement": {"diagram": {"x1": 150, "y1": 700, "x2": 250, "y2": 800}}}
    },
    "atm": {
