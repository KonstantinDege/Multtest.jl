"""
Take-off run from a standstill: full throttle from rest, flown by the `Pilot`.

The whole chain has to work together for this to mean anything --- static
thrust from the propeller, rolling friction and lateral restraint from the
gear, the tail coming up as elevator authority builds with airspeed, and the
wing taking the weight off the wheels until the contacts release cleanly.

The aircraft is *flown*, not released with a fixed stick. A fixed stick cannot
keep this aeroplane straight: the propeller torque reaction rolls it to the
left with nothing opposing it, and the spiral mode is divergent, so an
open-loop run leaves the ground correctly and then departs into a climbing
left turn --- which is a real result about the aircraft, but makes a poor
take-off. The pilot holds the tail-up attitude through the roll, rotates at
22 m/s and then holds the climb attitude with the wings level.
"""
test component TestMotorGliderTakeoff
  world = MultibodyComponents.World() {^world}
  atm = Atmosphere(rho0 = 1.225) {^atm}
  "Started from the settled parked attitude found by TestMotorGliderParked"
  glider = MotorGlider(has_gear = true, V_start = 0.0, gamma_start = 0.0, theta_start = 0.11327, r_start = [0.0, 0.7805, 0.0]) {^glider}
  "Tail up through the roll, rotate at 22 m/s, then hold 7 degrees of climb"
  pilot = Pilot(theta_ground = 0.0, theta_climb = 0.12, V_rotate = 22.0) {^pilot}
  rud = BlockComponents.Sources.Constant(k = 0.0) {^rud}
  "Full throttle from the start"
  thr = BlockComponents.Sources.Constant(k = 1.0) {^thr}
relations
  connect(atm.air, glider.air, pilot.air) {^id7}
  connect(glider.frame_datum, pilot.frame_a) {^id8}
  connect(pilot.elevator, glider.elevator) {^id9}
  connect(pilot.aileron, glider.aileron) {^id10}
  connect(rud.y, glider.rudder) {^id11}
  connect(thr.y, glider.throttle) {^id12}
metadata {
  "_links": {
    "world": {
      "Dyad": {"placement": {"diagram": {"x1": 60, "y1": 800, "x2": 160, "y2": 900}}}
    },
    "atm": {
      "Dyad": {"placement": {"diagram": {"x1": 460, "y1": 20, "x2": 560, "y2": 120}}}
    },
    "glider": {
      "Dyad": {"placement": {"diagram": {"x1": 460, "y1": 300, "x2": 560, "y2": 400}}}
    },
    "pilot": {
      "Dyad": {"placement": {"diagram": {"x1": 820, "y1": 300, "x2": 920, "y2": 400}}}
    },
    "rud": {
      "Dyad": {"placement": {"diagram": {"x1": 120, "y1": 420, "x2": 220, "y2": 520}}}
    },
    "thr": {
      "Dyad": {"placement": {"diagram": {"x1": 120, "y1": 580, "x2": 220, "y2": 680}}}
    },
    "id7": {
      "Dyad": {
        "edges": [
          {"S": 1, "M": [], "E": -1},
          {"S": -1, "M": [], "E": 2},
          {"S": -1, "M": [{"x": 870, "y": 170}], "E": 3}
        ],
        "junctions": [{"x": 510, "y": 170}]
      }
    },
    "id8": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "id9": {
      "Dyad": {"edges": [{"S": 1, "M": [{"x": 960, "y": 250}, {"x": 400, "y": 250}], "E": 2}]}
    },
    "id10": {
