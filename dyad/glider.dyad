"""
The complete glider, released at the longitudinal trim with the controls
centred.

Trim, the glide polar and the longitudinal and lateral modes are all found
from this harness with the helpers in `src/flightdynamics.jl`, which solve for
the steady glide directly rather than simulating and waiting to settle.
"""
test component TestGlider
  world = MultibodyComponents.World() {^world}
  atm = Atmosphere(rho0 = 1.225) {^atm}
  glider = Glider() {^glider}
  elev = BlockComponents.Sources.Constant(k = 0.0) {^elev}
  rud = BlockComponents.Sources.Constant(k = 0.0) {^rud}
  ail = BlockComponents.Sources.Constant(k = 0.0) {^ail}
relations
  connect(atm.air, glider.air) {^id7}
  connect(elev.y, glider.elevator) {^id8}
  connect(rud.y, glider.rudder) {^id9}
  connect(ail.y, glider.aileron) {^id10}
metadata {
  "_links": {
    "world": {
