"""
Standard class glider, 15 m span.

The fuselage `Body` is the free-flying base: it owns the position and the
quaternion orientation states and is *not* attached to the world by any
joint. Everything else hangs off its `frame_a`, whose axes are x forward,
y up, z to the right, matching the world frame convention.

# The datum is the centre of gravity

`fuselage.frame_a` is the aircraft datum, and the fuselage mass is placed
so that the *composite* centre of gravity of the whole aircraft falls
exactly on it: `r_cm_fuselage` is computed from the surface masses and
their stations rather than being set by hand. This is what ballast does on
a real glider, and it is what makes `x_ac_wing` mean "wing aerodynamic
centre ahead of the centre of gravity" --- the quantity that sets the
static margin --- instead of "ahead of an arbitrary reference point".

Change a surface mass or station and the fuselage mass moves to rebalance,
so the static margin stays the property of the aerodynamic geometry alone.

# Inertia axes

In this frame roll is about x, **yaw is about y** and **pitch is about z**,
so the diagonal inertia entries map as `I_11 = roll`, `I_22 = yaw`,
`I_33 = pitch`. The values are quoted about the fuselage's own centre of
mass, which is where `Body` expects them; the parallel axis shift to the
datum is done by `Body` from `r_cm`.
"""
component Glider
  "Density and wind"
  air = AirState() {^air}
  "Elevator deflection, positive trailing edge down, which pitches the nose down"
  elevator = RealInput() if has_htail {^elevator}
  "Rudder deflection, positive trailing edge to the right, which yaws the nose left"
  rudder = RealInput() if has_vtail {^rudder}
  "Aileron deflection, positive rolls the aircraft to the right (right wing down)"
  aileron = RealInput() {^aileron}
  "Engine throttle, 0 is off and 1 is full power"
  throttle = RealInput() if has_engine {^throttle}
  """
  The aircraft datum, exposed so that something outside can attach to it: a
  pilot model reading the attitude, a tow hook, a launch winch. Left
  unconnected it carries no force and changes nothing.
  """
  frame_datum = Frame3D() {^frame_datum}
  fuselage = MultibodyComponents.Body(m = m_fuselage, r_cm = r_cm_fuselage, I_11 = I_fus_roll, I_22 = I_fus_yaw, I_33 = I_fus_pitch, orientation_state = MultibodyComponents.OrientationState.Quaternion(), statePriority = 1000, linearStatePriority = 1000, initialize_orientation = false, r_0(initial = r_start), v_0(initial = v_start), Q_hat(initial = q_start)) {^fuselage}
  wing = Wing(has_control = true, b = b_wing, S = S_wing, x_ac = x_ac_wing, y_ac = y_ac_wing, dihedral = dihedral_wing, incidence = incidence_wing, m = m_wing, CL0 = CL0_wing, CL_alpha = CL_alpha_wing, CD0 = CD0_wing, CM0 = CM0_wing, e_oswald = e_oswald_wing, alpha_stall = alpha_stall_wing, CL_delta = CL_delta_ail, CM_delta = -0.45, CD_delta = CD_delta_ail) {^wing}
  """
  Ailerons act differentially, so the right panel takes the negated command.
  Positive `aileron` puts the left trailing edge down and the right up, which
  lifts the left wing and rolls the aircraft to the right.
  """
  ail_invert = BlockComponents.Math.Gain(k = -1.0) {^ail_invert}
  fus_mount = MultibodyComponents.FixedTranslation(r = [x_cp_fuselage, 0.0, 0.0], render = false) {^fus_mount}
  fus_vis = MultibodyComponents.CylinderVisualizer(render = render, color = [0.93, 0.93, 0.95, 1.0], radius = radius_fuselage * 1.0, length = l_fuselage * 1.0, length_direction = [-1.0, 0.0, 0.0], r_shape = [x_cp_fuselage + 0.25 * l_fuselage, 0.0, 0.0]) {^fus_vis}
  """
  The fin is the same `Wing` component as the tailplane, single panel, mounted
  through a +90 degree roll. In the rolled frame the surface's span axis points
  down, so its panel (which sits at -y_panel along the local span) ends up
  above the fuselage, and the surface's lift direction points to the right.
  Its incidence angle is therefore the sideslip angle and its lift is a side
  force, with no change to the panel model at all.
  
  The root offset has to be applied *before* the roll, in body axes, which is
  why it lives in `vtail_mount` rather than in the surface's own `x_ac`/`y_ac`.
  """
  vtail_mount = MultibodyComponents.FixedTranslation(r = [x_ac_vtail, y_ac_vtail, 0.0], render = false) if has_vtail {^vtail_mount}
  vtail_roll = MultibodyComponents.FixedRotation(n = [1.0, 0.0, 0.0], angle = 1.5707963267948966, render = false) if has_vtail {^vtail_roll}
  vtail = Wing(has_control = true, mirror_right = false, b = b_vtail, S = S_vtail, x_ac = 0.0, y_ac = 0.0, dihedral = 0.0, incidence = 0.0, m = m_vtail, I_panel = 1.0, CL0 = 0.0, CL_alpha = CL_alpha_vtail, CD0 = 0.009, CM0 = 0.0, e_oswald = 0.8, alpha_stall = alpha_stall_vtail, CL_delta = CL_delta_rud, CM_delta = -0.4, CD_delta = 0.02) if has_vtail {^vtail}
  fus_drag = DragBody(CdA_x = CdA_fus_x, CdA_y = CdA_fus_y, CdA_z = CdA_fus_z) {^fus_drag}
  prop_mount = MultibodyComponents.FixedTranslation(r = [x_prop, y_prop, 0.0], render = false) if has_engine {^prop_mount}
  mainwheel_l_mount = MultibodyComponents.FixedTranslation(r = [x_mainwheel, y_mainwheel, -track_mainwheel / 2], render = false) if has_gear {^mainwheel_l_mount}
  mainwheel_l = GroundContact(render = render, radius = r_mainwheel, k_n = k_mainwheel, d_n = d_mainwheel, mu_x = 0.03, mu_z = 0.7, ground_height = ground_height) if has_gear {^mainwheel_l}
  mainwheel_r_mount = MultibodyComponents.FixedTranslation(r = [x_mainwheel, y_mainwheel, track_mainwheel / 2], render = false) if has_gear {^mainwheel_r_mount}
  mainwheel_r = GroundContact(render = render, radius = r_mainwheel, k_n = k_mainwheel, d_n = d_mainwheel, mu_x = 0.03, mu_z = 0.7, ground_height = ground_height) if has_gear {^mainwheel_r}
  tailwheel_mount = MultibodyComponents.FixedTranslation(r = [x_tailwheel, y_tailwheel, 0.0], render = false) if has_gear {^tailwheel_mount}
  tailwheel = GroundContact(render = render, w_vis = 0.04, radius = r_tailwheel, k_n = k_minorgear, d_n = d_minorgear, mu_x = 0.04, mu_z = 0.5, ground_height = ground_height) if has_gear {^tailwheel}
  tipskid_l_mount = MultibodyComponents.FixedTranslation(r = [0.0, y_tipskid, -b_wing / 2], render = false) if has_gear {^tipskid_l_mount}
  tipskid_l = GroundContact(render = render, w_vis = 0.04, radius = 0.0, k_n = k_minorgear, d_n = d_minorgear, mu_x = 0.3, mu_z = 0.3, ground_height = ground_height) if has_gear {^tipskid_l}
  tipskid_r_mount = MultibodyComponents.FixedTranslation(r = [0.0, y_tipskid, b_wing / 2], render = false) if has_gear {^tipskid_r_mount}
  tipskid_r = GroundContact(render = render, w_vis = 0.04, radius = 0.0, k_n = k_minorgear, d_n = d_minorgear, mu_x = 0.3, mu_z = 0.3, ground_height = ground_height) if has_gear {^tipskid_r}
  propeller = Propeller(D = D_prop, P_rated = P_engine, n_rated = n_rated_engine, I_shaft = I_shaft_engine) if has_engine {^propeller}
  """
  The tailplane sits in the wing's wake. Driving it from the wing's *lift*
  rather than from a fixed `deps/dalpha` means the reduction in tail
  effectiveness follows the wing through the stall as well as in the linear
  range, and costs nothing extra to state.
  """
  downwash = Downwash(b = b_wing, k = k_downwash) if has_htail and has_downwash {^downwash}
  htail = Wing(has_induced_flow = has_downwash, has_control = true, b = b_htail, S = S_htail, x_ac = x_ac_htail, y_ac = y_ac_htail, dihedral = 0.0, incidence = incidence_htail, m = m_htail, I_panel = 2.0, CL0 = 0.0, CL_alpha = 4.4, CD0 = 0.008, CM0 = 0.0, e_oswald = 0.85, alpha_stall = 0.244, CL_delta = CL_delta_elev, CM_delta = -0.55, CD_delta = 0.02) if has_htail {^htail}
  "Fit a horizontal tail; false leaves the aircraft pitch unstable on purpose"
  structural parameter has_htail::Boolean = true
  "Fit a fin; false leaves the aircraft directionally unstable on purpose"
  structural parameter has_vtail::Boolean = true
  "Put the tailplane in the wing's downwash; false over-states the tail's effectiveness"
  structural parameter has_downwash::Boolean = true
  "Fit a nose-mounted engine and propeller, turning the glider into a motor glider"
  structural parameter has_engine::Boolean = false
  """
  Fit the landing gear: a pair of main wheels on a track, a tailwheel, and a
  skid under each wing tip.
  
  The main wheels being a *pair* is what makes the aircraft stand up on its
  own. A single centreline wheel leaves upright as an unstable equilibrium --
  it will fall onto a wingtip from nothing more than rounding error, exactly as
  a real monowheel glider does. With a track the tip-over angle is
  `atan(track/2 / h_cg)`, comfortably beyond anything a ground run reaches, and
  the tip skids become what they should be: protection against a dropped wing,
  not load-bearing structure.
  """
  structural parameter has_gear::Boolean = false
  "Fraction of the far-field downwash the tailplane sees"
  parameter k_downwash::Real = 1.0
  "Draw the aircraft"
  parameter render::Boolean = true
  # --- fuselage -------------------------------------------------------------
  "Mass of the fuselage, including the pilot and everything not in a surface"
  parameter m_fuselage::Mass = 230.0
  "Fuselage roll inertia about its own centre of mass"
  parameter I_fus_roll::Inertia = 35.0
  "Fuselage yaw inertia about its own centre of mass"
  parameter I_fus_yaw::Inertia = 700.0
  "Fuselage pitch inertia about its own centre of mass"
  parameter I_fus_pitch::Inertia = 700.0
  # --- launch condition -----------------------------------------------------
  """
  Launch state, given the way a flight condition is actually quoted: a
  speed, a flight path angle and a pitch attitude. The incidence follows as
  `theta_start - gamma_start`. The defaults are the hand-computed trim of
  the rig below; a residual here simply excites the phugoid.
  """
  parameter r_start::Position[3] = [0.0, 500.0, 0.0]
  "Airspeed at release"
  parameter V_start::Velocity = 25.0
  "Flight path angle at release, negative descending"
  parameter gamma_start::Angle = -0.030476
  "Pitch attitude at release, positive nose up"
  parameter theta_start::Angle = 0.019560
  "Sideslip at release, positive with the relative wind from the right"
  parameter beta_start::Angle = 0.0
  "Bank angle at release, positive right wing down"
  parameter phi_start::Angle = 0.0
  """
  Initial velocity of the datum, world frame. Sideslip enters as a lateral
  velocity component with the attitude unchanged, which is what sideslip is;
  the magnitude stays `V_start` for any `beta_start`.
  """
  final parameter v_start::Velocity[3] = [V_start * cos(gamma_start) * cos(beta_start), V_start * sin(gamma_start), V_start * cos(gamma_start) * sin(beta_start)]
  """
  Initial attitude quaternion [w,i,j,k]. Pitch is a rotation about the body z
  axis and bank a rotation about the body x axis; this is the Hamilton product
  `q_pitch * q_roll`, so the bank is applied in the pitched body frame.
  """
  final parameter q_start::Real[4] = [cos(theta_start / 2) * cos(phi_start / 2), cos(theta_start / 2) * sin(phi_start / 2), sin(theta_start / 2) * sin(phi_start / 2), sin(theta_start / 2) * cos(phi_start / 2)]
  # --- wing -----------------------------------------------------------------
  "Wing span"
  parameter b_wing::Length = 15.0
  "Wing area"
  parameter S_wing::Area = 10.5
  """
  Wing aerodynamic centre ahead of the centre of gravity. This is the static
  margin knob: because the datum is the centre of gravity, moving the wing
  aerodynamic centre forward is the same as moving the centre of gravity aft,
  and the neutral point follows at about 0.9 times the change.
  
  0.145 m puts the aircraft at 15% MAC, in the usual sailplane band. Note this
  had to move forward from 0.205 when downwash was switched on: downwash cuts
  the tail's contribution by 17%, but the *net* `Mw` is a small difference of a
  destabilising wing term and a stabilising tail term, so a 17% cut to the tail
  took the static margin from 14% down to 8%.
  """
  parameter x_ac_wing::Length = 0.145
  "Wing aerodynamic centre above the centre of gravity"
  parameter y_ac_wing::Length = 0.0
  "Wing dihedral"
  parameter dihedral_wing::Angle = 0.052
  "Wing incidence relative to the fuselage datum, so the fuselage flies near zero incidence"
  parameter incidence_wing::Angle = 0.05236
  "Wing mass"
  parameter m_wing::Mass = 100.0
  """
  Lift coefficient per radian of aileron, as seen by the whole semi-span panel.
  
  This is a *lumped equivalent*, not a section value, and it has to be because
  there is one panel per semi-span while a real aileron covers only its outer
  part. It is set so the panel produces the correct rolling moment: for an
  aileron running from 0.50 to 0.95 semi-span with an effectiveness of 0.5,
  
      dL_roll/d(delta) = 2*q*a*tau*integral(c*y dy) = 73.2*q
  
  and the single panel gives `2*q*S_panel*CL_delta*y_panel = 45.5*q*CL_delta`,
  hence 1.61.
  
  Two consequences worth knowing. The panel's own lift coefficient swings less
  than the real aileron strip's does, so this under-predicts tip stall at large
  deflection. And the induced-drag asymmetry that causes adverse yaw acts at
  `y_panel` rather than at the aileron's own centroid further out, so the
  adverse yaw is low by roughly 20%. Both are fixed by raising the panel count,
  not by adjusting this number.
  """
  parameter CL_delta_ail::Real = 1.611
  "Wing drag coefficient per radian squared of aileron deflection"
  parameter CD_delta_ail::Real = 0.05
  "Wing lift coefficient at zero incidence"
  parameter CL0_wing::Real = 0.25
  "Wing lift curve slope, per radian, for the wing's own aspect ratio"
  parameter CL_alpha_wing::Real = 5.7
  "Wing profile drag coefficient"
  parameter CD0_wing::Real = 0.008
  "Wing pitching moment coefficient about the aerodynamic centre at zero lift"
  parameter CM0_wing::Real = -0.09
  "Wing Oswald span efficiency"
  parameter e_oswald_wing::Real = 0.95
  "Incidence at the centre of the wing's stall blend"
  parameter alpha_stall_wing::Angle = 0.244
  # --- horizontal tail ------------------------------------------------------
  "Tailplane span"
  parameter b_htail::Length = 2.2
  "Tailplane area"
  parameter S_htail::Area = 1.0
  "Tailplane aerodynamic centre ahead of the centre of gravity; negative is aft"
  parameter x_ac_htail::Length = -4.0
  "Tailplane aerodynamic centre above the centre of gravity"
  parameter y_ac_htail::Length = 0.25
  """
  Tailplane incidence relative to the fuselage datum. This is the rigging
  angle that sets the trim speed, and it is what the elevator would otherwise
  have to hold: rig it so the elevator sits near zero at the best glide speed,
  or the aircraft cruises with the stick permanently displaced.
  
  It is set here for a centre of gravity at 15% MAC with downwash active. The
  tailplane carries only a small load at trim, so the incidence is close to
  zero. Move `x_ac_wing`, or switch downwash off, and this has to be re-rigged
  with it.
  """
  parameter incidence_htail::Angle = 0.007662
  "Tailplane mass"
  parameter m_htail::Mass = 12.0
  "Tailplane lift coefficient per radian of elevator deflection"
  parameter CL_delta_elev::Real = 2.2
  # --- vertical tail --------------------------------------------------------
  "Fin height above its root"
  parameter b_vtail::Length = 1.2
  "Fin area"
  parameter S_vtail::Area = 0.8
  "Fin aerodynamic centre ahead of the centre of gravity; negative is aft"
  parameter x_ac_vtail::Length = -3.8
  "Fin root above the centre of gravity"
  parameter y_ac_vtail::Length = 0.3
  "Fin mass"
  parameter m_vtail::Mass = 8.0
  """
  Fin lift curve slope per radian.
  
  Well below the wing's because the fin's geometric aspect ratio is only 1.8,
  but above the plain `2*pi*AR/(AR+2)` that geometry alone would give: the
  fuselage acts as an endplate at the root and the tailplane partly does the
  same at the top, so the *effective* aspect ratio is roughly 1.5 to 2 times
  geometric. At 3.0 the aircraft's `C_n_beta` came out at 0.039, below the
  0.05 to 0.10 that sailplanes normally show; 3.8 puts it at 0.054.
  """
  parameter CL_alpha_vtail::Real = 3.8
  """
  Incidence at which the fin's flow separates. Low aspect ratio surfaces hold
  on well past the angle a high aspect ratio wing stalls at, so this sits at
  20 degrees rather than the wing's 14. It matters: once sideslip exceeds it
  the fin stops restoring and the spiral departs with nothing to arrest it.
  """
  parameter alpha_stall_vtail::Angle = 0.35
  "Fin side force coefficient per radian of rudder deflection"
  parameter CL_delta_rud::Real = 1.5
  # --- fuselage aerodynamics ------------------------------------------------
  """
  Station of the fuselage drag point, ahead of the centre of gravity. Slender
  body theory puts the body's normal force about a quarter of the body length
  behind the nose, which for this fuselage is just ahead of the centre of
  gravity; that is what produces the fuselage's destabilising contribution to
  pitch and yaw, so the station matters more than the drag areas do.
  """
  parameter x_cp_fuselage::Length = 0.225
  """
  Fuselage length, nose to tail. Only drawn, not used aerodynamically. The
  drawn body is placed so its nose sits a quarter of the body length ahead of
  `x_cp_fuselage` --- the same slender-body assumption that station rests on,
  so the picture and the aerodynamic model cannot drift apart.
  
  Note the shape dimensions must be passed as *expressions* rather than as bare
  parameter symbols. The visualizers declare `length`, `width` and `r_shape` as
  time-dependent variables, so binding one to a bare parameter puts that
  parameter and a variable in the same alias set, and anything else deriving a
  parameter from it then fails with "could not evaluate value of parameter".
  """
  parameter l_fuselage::Length = 6.3
  "Fuselage radius, for drawing"
  parameter radius_fuselage::Length = 0.32
  # --- propulsion -----------------------------------------------------------
  "Propeller disc station, ahead of the centre of gravity"
  parameter x_prop::Length = 2.0
  """
  Thrust line above the centre of gravity. Not a detail: thrust acting above
  the centre of gravity pitches the nose down as power comes on, which is the
  trim change every pilot of a high-thrustline motor glider feels.
  """
  parameter y_prop::Length = 0.20
  "Propeller diameter"
  parameter D_prop::Length = 1.5
  "Rated shaft power"
  parameter P_engine::Real = 59700
  "Shaft speed at rated power, revolutions per second"
  parameter n_rated_engine::Real = 45.0
  "Rotating inertia of crankshaft and propeller"
  parameter I_shaft_engine::Inertia = 0.35
  # --- landing gear ---------------------------------------------------------
  """
  Main wheel axle station, ahead of the centre of gravity. Keep it a little
  ahead: a taildragger pivots about its main wheels, so wheels behind the
  centre of gravity would let it sit on its nose.
  """
  parameter x_mainwheel::Length = 0.12
  "Main wheel axle below the centre of gravity"
  parameter y_mainwheel::Length = -0.62
  "Main wheel radius"
  parameter r_mainwheel::Length = 0.20
  """
  Distance between the two main wheels. Sets the tip-over angle together with
  the centre of gravity height, and sets how much yaw restraint the pair gives
  against a swing on the ground.
  """
  parameter track_mainwheel::Length = 1.80
  "Tailwheel station, behind the centre of gravity"
  parameter x_tailwheel::Length = -4.30
  "Tailwheel axle below the centre of gravity"
  parameter y_tailwheel::Length = -0.24
  "Tailwheel radius"
  parameter r_tailwheel::Length = 0.06
  "Wing tip skid below the centre of gravity"
  parameter y_tipskid::Length = -0.05
  "Normal stiffness of each main wheel; the pair together carries the weight"
  parameter k_mainwheel::Real = 1.0e5
  "Normal damping of each main wheel"
  parameter d_mainwheel::Real = 7.5e4
  "Normal stiffness of the tailwheel and tip skids"
  parameter k_minorgear::Real = 5.0e4
  "Normal damping of the tailwheel and tip skids"
  parameter d_minorgear::Real = 5.0e4
  "Height of the ground plane"
  parameter ground_height::Length = 0.0
  "Fuselage axial drag area Cd*S; the equivalent flat plate area of a clean glider"
  parameter CdA_fus_x::Area = 0.05
  "Fuselage normal drag area Cd*S, from the plan area and a slender-body cross-flow Cd"
  parameter CdA_fus_y::Area = 2.1
  "Fuselage side drag area Cd*S, from the side area and a slender-body cross-flow Cd"
  parameter CdA_fus_z::Area = 2.4
  "Spanwise station of the wing panels"
  final parameter y_panel_wing::Length = b_wing / (2 * sqrt(3.0))
  "Height of the wing mass above the datum"
  final parameter y_cm_wing::Length = y_ac_wing + y_panel_wing * sin(dihedral_wing)
  "Mass of the tailplane actually fitted"
  final parameter m_htail_fitted::Mass = ifelse(has_htail, m_htail, 0.0)
  "Mass of the fin actually fitted"
  final parameter m_vtail_fitted::Mass = ifelse(has_vtail, m_vtail, 0.0)
  "Height of the fin mass above the datum"
  final parameter y_cm_vtail::Length = y_ac_vtail + b_vtail / (2 * sqrt(3.0))
  "Total aircraft mass"
  final parameter m_total::Mass = m_fuselage + m_wing + m_htail_fitted + m_vtail_fitted
  """
  Fuselage centre of mass relative to the datum, chosen so that the
  composite centre of gravity of the aircraft lands on the datum.
  """
  final parameter r_cm_fuselage::Position[3] = -(m_wing * [x_ac_wing, y_cm_wing, 0.0] + m_htail_fitted * [x_ac_htail, y_ac_htail, 0.0] + m_vtail_fitted * [x_ac_vtail, y_cm_vtail, 0.0]) / m_fuselage
relations
  connect(fuselage.frame_a, wing.frame_a) {^id30}
  connect(air, wing.air) {^id31}
  connect(aileron, wing.delta_l, ail_invert.u) {^id32}
  connect(ail_invert.y, wing.delta_r) {^id33}
  connect(fuselage.frame_a, frame_datum) {^id34}
  connect(fuselage.frame_a, fus_mount.frame_a, fus_vis.frame_a) {^id35}
  connect(fus_mount.frame_b, fus_drag.frame_a) {^id36}
  connect(air, fus_drag.air) {^id37}
  if has_htail
    connect(fuselage.frame_a, htail.frame_a)
    connect(air, htail.air)
    connect(elevator, htail.delta_l, htail.delta_r)
    if has_downwash
      connect(fuselage.frame_a, downwash.frame_a)
      connect(air, downwash.air)
      connect(wing.L_total, downwash.L_up)
      connect(downwash.w_dw, htail.w_induced)
    end
  end
  if has_gear
    connect(fuselage.frame_a, mainwheel_l_mount.frame_a)
    connect(mainwheel_l_mount.frame_b, mainwheel_l.frame_a)
    connect(fuselage.frame_a, mainwheel_r_mount.frame_a)
    connect(mainwheel_r_mount.frame_b, mainwheel_r.frame_a)
    connect(fuselage.frame_a, tailwheel_mount.frame_a)
    connect(tailwheel_mount.frame_b, tailwheel.frame_a)
    connect(fuselage.frame_a, tipskid_l_mount.frame_a)
    connect(tipskid_l_mount.frame_b, tipskid_l.frame_a)
    connect(fuselage.frame_a, tipskid_r_mount.frame_a)
    connect(tipskid_r_mount.frame_b, tipskid_r.frame_a)
  end
  if has_engine
    connect(fuselage.frame_a, prop_mount.frame_a)
    connect(prop_mount.frame_b, propeller.frame_a)
    connect(air, propeller.air)
    connect(throttle, propeller.throttle)
  end
  if has_vtail
    connect(fuselage.frame_a, vtail_mount.frame_a)
    connect(vtail_mount.frame_b, vtail_roll.frame_a)
    connect(vtail_roll.frame_b, vtail.frame_a)
    connect(air, vtail.air)
    connect(rudder, vtail.delta_l)
  end
metadata {
  "Dyad": {
    "icons": {"default": "dyad://Multtest/Glider.svg"},
    "doc": {"behavior": false}
  },
  "_links": {
    "air": {
      "Dyad": {
        "placement": {
          "icon": {"x1": 450, "y1": -50, "x2": 550, "y2": 50},
          "diagram": {"x1": -60, "x2": 40, "y1": 850, "y2": 950}
        }
      }
    },
    "elevator": {
