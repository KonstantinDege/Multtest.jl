"""
Free flight with the wing only, released level.

With no tailplane the wing lift acts ahead of the centre of gravity, so
`dCm/dalpha` has the wrong sign and the aircraft has no pitch stiffness:
the expected result is a monotone pitch departure, not a glide. This is the
increment that proves the tail is what stabilises the aircraft rather than
some artefact of the assembly.
"""
test component TestGliderWingOnly
  world = MultibodyComponents.World() {^world}
  atm = Atmosphere(rho0 = 1.225) {^atm}
  glider = Glider(has_htail = false, has_vtail = false) {^glider}
  ail = BlockComponents.Sources.Constant(k = 0.0) {^ail}
relations
  connect(atm.air, glider.air) {^id5}
  connect(ail.y, glider.aileron) {^id6}
metadata {
  "_links": {
    "world": {
      "Dyad": {"placement": {"diagram": {"x1": 150, "y1": 560, "x2": 250, "y2": 660}}}
    },
    "atm": {
      "Dyad": {"placement": {"diagram": {"x1": 880, "y1": 110, "x2": 980, "y2": 210}}}
    },
    "glider": {
      "Dyad": {"placement": {"diagram": {"x1": 450, "y1": 110, "x2": 550, "y2": 210}}}
    },
    "ail": {
      "Dyad": {"placement": {"diagram": {"x1": 155, "y1": 230, "x2": 255, "y2": 330}}}
    },
    "id5": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "id6": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 462, "y": 280}], "E": 2}]}}
  }
}
end

"""
Wing and tailplane but no fin, released at the longitudinal trim.

Pitch is now stable, but with nothing to weathercock the aircraft there is no
yaw stiffness worth the name, and the lateral modes are divergent. Kept as the
counterpart to `TestGliderWingOnly`: it shows what the fin is responsible for.
"""
test component TestGliderNoFin
  world = MultibodyComponents.World() {^world}
  atm = Atmosphere(rho0 = 1.225) {^atm}
  glider = Glider(has_vtail = false) {^glider}
  elev = BlockComponents.Sources.Constant(k = 0.0) {^elev}
  ail = BlockComponents.Sources.Constant(k = 0.0) {^ail}
relations
  connect(atm.air, glider.air) {^id6}
  connect(elev.y, glider.elevator) {^id7}
  connect(ail.y, glider.aileron) {^id8}
metadata {
  "_links": {
    "world": {
      "Dyad": {"placement": {"diagram": {"x1": 150, "y1": 560, "x2": 250, "y2": 660}}}
    },
