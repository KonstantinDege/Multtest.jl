    "ail": {
      "Dyad": {"placement": {"diagram": {"x1": 155, "y1": 20, "x2": 255, "y2": 120}}}
    },
    "id7": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "id8": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 525, "y": 400}], "E": 2}]}},
