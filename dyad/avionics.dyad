"""
The clocked half of `DigitalAutopilot`: the control law itself, on a clock.

Every relation here lives on the clock parameter `clk`, and every signal on
the interface is a clocked signal. There is no sampler and no hold in this
component --- it is the flight computer's arithmetic and nothing else, which
is what makes it testable on its own against a bare clock.

# What a sampled law changes

* **The rate terms are backward differences of the sampled attitude**,
  `(theta_k - theta_k-1)/Ts`, not `der(theta)`. A digital controller cannot
  differentiate a continuous signal; it differences successive samples.
* **The integral is an explicit Euler sum**, `xi_k = xi_k-1 + Ts*e_k`, and
  the anti-windup factor reads the *previous* output, because a causal
  discrete loop cannot use the output it is in the middle of computing.

The anti-windup factor `1 - (de_k-1/delta_max)^2` is the local gain of the
`tanh` saturation, so the integrator gives up exactly as fast as the control
runs out of authority.

# Sample period

`Ts` appears explicitly in the difference and the sum, so it must agree with
the clock that `clk` resolves to. `DigitalAutopilot` passes its own `Ts` to
both this component and the `PeriodicClock`, which is what keeps them in
step; a direct user of this component has to do the same.
"""
component AutopilotLaw@[input clk extends Discrete]
  "Sampled pitch attitude"
  theta = RealInput@[clk]() {^theta}
  "Sampled bank angle"
  phi = RealInput@[clk]() {^phi}
  "Sampled airspeed"
  V = RealInput@[clk]() {^V}
  "Elevator command at the tick, positive trailing edge down"
  elevator = RealOutput@[clk]() {^elevator}
  "Aileron command at the tick, positive rolls right"
  aileron = RealOutput@[clk]() {^aileron}
  "Sample period; must match the clock bound to `clk`"
  parameter Ts::Real = 0.02
  "Pitch attitude held below the rotation speed"
  parameter theta_ground::Angle = 0.0
  "Pitch attitude held above the rotation speed"
  parameter theta_climb::Angle = 0.12
  "Airspeed at which the aircraft is rotated"
  parameter V_rotate::Velocity = 22.0
  "Width of the blend between the two commanded attitudes"
  parameter V_blend::Velocity = 1.5
  "Bank angle held throughout, positive right wing down"
  parameter phi_cmd::Angle = 0.0
  "Elevator per radian of pitch error"
  parameter k_theta::Real = 0.25
  "Elevator per radian per second of pitch rate"
  parameter kd_theta::Real = 0.06
  "Aileron per radian of bank error"
  parameter k_phi::Real = 0.35
  "Aileron per radian per second of roll rate"
  parameter kd_phi::Real = 0.05
  "Time over which a standing attitude error is trimmed away, both axes"
  parameter T_i::Real = 4.0
  "Control deflection limit, both axes"
  parameter delta_max::Angle = 0.35
  "Commanded pitch attitude"
  variable theta_cmd::Real
  "Pitch error at the tick"
  variable e_theta::Real
  "Bank error at the tick"
  variable e_phi::Real
  "Pitch rate, backward difference of samples"
  variable dtheta::Real
  "Roll rate, backward difference of samples"
  variable dphi::Real
  "Accumulated pitch error"
  variable xi_theta::Real
  "Accumulated bank error"
  variable xi_phi::Real
  "Elevator command at the tick"
  variable de::Real
  "Aileron command at the tick"
  variable da::Real
relations
  # Rotation is keyed to airspeed, not to a clock time, so the take-off stays
  # self-sequencing when the mass or the thrust changes.
  theta_cmd@clk = theta_ground + (theta_climb - theta_ground) * 0.5 * (1 + tanh((V@clk - V_rotate) / V_blend))
  e_theta@clk = theta@clk - theta_cmd@clk
  e_phi@clk = phi@clk - phi_cmd
  # Rates by backward difference, not by differentiation
  dtheta@clk = (theta@clk - theta@(clk-1)) / Ts
  dphi@clk = (phi@clk - phi@(clk-1)) / Ts
  # Integral, Euler, anti-windup off the previous output
  xi_theta@clk = xi_theta@(clk-1) + Ts * e_theta@clk * (1 - (de@(clk-1) / delta_max) ^ 2)
  xi_phi@clk = xi_phi@(clk-1) + Ts * e_phi@clk * (1 - (da@(clk-1) / delta_max) ^ 2)
  # Control law
  de@clk = delta_max * tanh((k_theta * (e_theta@clk + xi_theta@clk / T_i) + kd_theta * dtheta@clk) / delta_max)
  da@clk = delta_max * tanh((-k_phi * (e_phi@clk + xi_phi@clk / T_i) - kd_phi * dphi@clk) / delta_max)
  elevator@clk = de@clk
  aileron@clk = da@clk
  # The previous sample is seeded with the current one, so the first backward
  # difference is zero rather than a step out of nowhere.
  initial theta@(clk-1) = theta@clk
  initial phi@(clk-1) = phi@clk
  initial xi_theta@(clk-1) = 0.0
  initial xi_phi@(clk-1) = 0.0
  initial de@(clk-1) = 0.0
  initial da@(clk-1) = 0.0
metadata {
  "_links": {
    "theta": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 200, "x2": 50, "y2": 300}}}},
    "phi": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 450, "x2": 50, "y2": 550}}}},
    "V": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 700, "x2": 50, "y2": 800}}}},
    "elevator": {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 300, "x2": 1050, "y2": 400}}}},
    "aileron": {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 600, "x2": 1050, "y2": 700}}}}
  }
}
end

"""
Sampled-data attitude hold: the same two loops as `Pilot`, running on a clock.

This is the whole flight computer --- the converters as well as the
arithmetic. It presents continuous ports, so from outside it is a drop-in for
`Pilot`, and inside it is the three pieces a sampled controller actually has:

* a `PeriodicClock` at `Ts`, which is what pins the rate;
* a `Sampler` on each measurement, and the control law `AutopilotLaw` on the
  clock;
* a `ZeroOrderHold` on each command, so the roughly `Ts/2` of phase lag the
  hold costs is in the model rather than absent from it.

Everything else --- the gains, the `tanh` saturation, the rotation keyed on
airspeed rather than on a clock time --- is carried over from `Pilot`
unchanged, so that at a fast sample rate this reproduces `Pilot` and any
difference between the two is the sampling and nothing else.

# Sample period

`Ts` is a **structural** parameter: the clock is constructed when the
component is built, so changing the rate rebuilds the model rather than
re-running it. It is passed to both the clock and the law, which is what
keeps the difference and the sum consistent with the rate they run at.

# Compiling

The clocked equations need SynchToolkit's synchronous pass. `simplify_model`
adds it on its own; `multibody` does not, so a clocked harness has to be
built with

    multibody(model; additional_passes = [SynchToolkit.compile_lustre])

or it dies with `HybridSystemNotSupportedException`.
"""
component DigitalAutopilot
  "Measured pitch attitude"
  theta = RealInput() {^theta}
  "Measured bank angle"
  phi = RealInput() {^phi}
  "Measured airspeed"
  V = RealInput() {^V}
  "Elevator command, positive trailing edge down, held between ticks"
  elevator = RealOutput() {^elevator}
  "Aileron command, positive rolls right, held between ticks"
  aileron = RealOutput() {^aileron}
  "Pins the rate of the whole controller"
  clock = DiscreteComponents.PeriodicClock(dt = Ts) {^clock}
  # The pitch loop and the roll loop share no equation --- this law has no
  # turn compensation and no cross-feed --- so they reach the compiler as two
  # separate clock partitions and the clock source pins only the one it is
  # connected to. A second `PeriodicClock` is not the fix: two clock sources
  # in one component body is an `invalid-clock-usage` error. `ClockPropagator`
  # ties the roll loop's clock to the pitch loop's without tying their values.
  # Airspeed needs no tie: it feeds `theta_cmd`, so it is already in the pitch
  # partition.
  "Ties the roll loop to the same clock as the pitch loop"
  tie_roll = DiscreteComponents.ClockPropagator() {^tie_roll}
  s_theta = DiscreteComponents.Sampler() {^s_theta}
  s_phi = DiscreteComponents.Sampler() {^s_phi}
  s_V = DiscreteComponents.Sampler() {^s_V}
  "The control law, on the clock"
  law = AutopilotLaw(Ts = Ts, theta_ground = theta_ground, theta_climb = theta_climb, V_rotate = V_rotate, V_blend = V_blend, phi_cmd = phi_cmd, k_theta = k_theta, kd_theta = kd_theta, k_phi = k_phi, kd_phi = kd_phi, T_i = T_i, delta_max = delta_max) {^law}
  "Held commands, the single boundary back to continuous time"
  h_elevator = DiscreteComponents.ZeroOrderHold() {^h_elevator}
  h_aileron = DiscreteComponents.ZeroOrderHold() {^h_aileron}
  "Sample period; the clock is built with the component, so this is structural"
  structural parameter Ts::Real = 0.02
  "Pitch attitude held below the rotation speed"
  parameter theta_ground::Angle = 0.0
  "Pitch attitude held above the rotation speed"
  parameter theta_climb::Angle = 0.12
  "Airspeed at which the aircraft is rotated"
  parameter V_rotate::Velocity = 22.0
  "Width of the blend between the two commanded attitudes"
  parameter V_blend::Velocity = 1.5
  "Bank angle held throughout, positive right wing down"
  parameter phi_cmd::Angle = 0.0
  "Elevator per radian of pitch error"
  parameter k_theta::Real = 0.25
  "Elevator per radian per second of pitch rate"
  parameter kd_theta::Real = 0.06
  "Aileron per radian of bank error"
  parameter k_phi::Real = 0.35
  "Aileron per radian per second of roll rate"
  parameter kd_phi::Real = 0.05
  "Time over which a standing attitude error is trimmed away, both axes"
  parameter T_i::Real = 4.0
  "Control deflection limit, both axes"
  parameter delta_max::Angle = 0.35
relations
  connect(theta, s_theta.u) {^id14}
  connect(phi, s_phi.u) {^id15}
  connect(V, s_V.u) {^id16}
  connect(s_theta.y, law.theta, clock.y, tie_roll.u) {^id17}
  connect(s_phi.y, law.phi, tie_roll.y) {^id18}
  connect(s_V.y, law.V) {^id19}
  connect(law.elevator, h_elevator.u) {^id20}
  connect(law.aileron, h_aileron.u) {^id21}
  connect(h_elevator.y, elevator) {^id22}
  connect(h_aileron.y, aileron) {^id23}
